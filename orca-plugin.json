{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "purser",
  "name": "Purser",
  "version": "0.1.0",
  "execution": "trusted-worker",
  "description": "Paste API keys into a masked field instead of the chat. Claude Code, Codex and other agents use them by name, per project, and never see the values.",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "An agent asks for STRIPE_API_KEY, you paste it into a masked field in Orca, and the output shows [purser:STRIPE_API_KEY] instead."
  },
  "author": {
    "name": "Santi Gamo",
    "url": "https://github.com/santigamo"
  },
  "homepage": "https://github.com/santigamo/orca-purser",
  "repository": "https://github.com/santigamo/orca-purser",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "purser",
        "title": "Purser",
        "icon": "package",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "purser.status",
        "title": "Purser: Show what is stored and what agents are waiting for"
      },
      {
        "id": "purser.setupOutside",
        "title": "Purser: Set up agents outside Orca"
      },
      {
        "id": "purser.removeOutside",
        "title": "Purser: Remove setup for agents outside Orca"
      }
    ],
    "statusBarItems": [
      {
        "id": "purser",
        "text": "Purser",
        "icon": "package",
        "tooltip": "Purser: secrets for your agents",
        "command": "purser.status"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      },
      {
        "event": "agent.tool.before"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "secrets:own"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
